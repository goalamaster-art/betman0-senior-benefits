---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCategory, formatDate, getThumbnailPath } from '../../lib/categories';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const cat = getCategory(entry.data.category)!;

const allArticles = await getCollection('articles');
const sameCategory = allArticles
  .filter((a) => a.data.category === entry.data.category && a.id !== entry.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const otherCategory = allArticles
  .filter((a) => a.data.category !== entry.data.category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const related = [...sameCategory, ...otherCategory].slice(0, 3);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const readingMinutes = Math.max(1, Math.ceil(entry.body.length / 500));

const articleUrl = new URL(`/article/${entry.id}`, Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.metaDescription,
    url: articleUrl,
    datePublished: entry.data.publishedAt.toISOString(),
    dateModified: entry.data.updatedAt.toISOString(),
    inLanguage: 'ko-KR',
    author: { '@type': 'Organization', name: '든든지원금' },
    publisher: { '@type': 'Organization', name: '든든지원금' },
    keywords: entry.data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/category/${cat.slug}`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: articleUrl },
    ],
  },
  ...(entry.data.faqs && entry.data.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: entry.data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---
<BaseLayout title={`${entry.data.title} | 든든지원금`} description={entry.data.metaDescription} jsonLd={jsonLd} image={getThumbnailPath(entry.id)}>
  <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-[1fr_240px] gap-8 py-8">
    <article>
      <nav class="text-xs text-brand-muted mb-3">
        <a href="/" class="hover:text-brand-blue">홈</a> / <a href={`/category/${cat.slug}`} class="hover:text-brand-blue">{cat.name}</a>
      </nav>
      <span class="inline-block text-xs font-bold text-brand-blue bg-brand-blue-light rounded-full px-2.5 py-1 mb-3">{cat.name}</span>
      <h1 class="text-2xl md:text-3xl font-bold text-brand-navy leading-snug mb-3">{entry.data.title}</h1>
      <div class="flex flex-wrap gap-3 text-xs text-brand-muted mb-6">
        <span>발행일 {formatDate(entry.data.publishedAt)}</span>
        <span>·</span>
        <span>최종수정 {formatDate(entry.data.updatedAt)}</span>
        <span>·</span>
        <span>읽는 시간 약 {readingMinutes}분</span>
      </div>

      <div class="bg-brand-blue-light border border-brand-blue/20 rounded-xl p-5 mb-6">
        <div class="font-bold text-brand-navy mb-2 text-sm">💡 핵심 요약</div>
        <ul class="space-y-1.5 text-sm text-brand-text">
          {entry.data.keyTakeaways.map((k) => <li class="flex gap-2"><span class="text-brand-blue">•</span>{k}</li>)}
        </ul>
      </div>

      <AdSlot label="도입부" />

      {toc.length > 0 && (
        <nav class="md:hidden bg-white border border-brand-border rounded-xl p-5 mb-6 text-sm">
          <div class="font-bold text-brand-navy mb-2">목차</div>
          <ul class="space-y-1">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'pl-4' : ''}>
                <a href={`#${h.slug}`} class="text-brand-muted hover:text-brand-blue">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose-article">
        <Content />
      </div>

      <AdSlot label="본문 중간" />

      {entry.data.faqs && entry.data.faqs.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-bold mt-10 mb-4 pl-3 border-l-4 border-brand-blue text-brand-navy">자주 묻는 질문</h2>
          <div class="space-y-3">
            {entry.data.faqs.map((f) => (
              <details class="bg-white border border-brand-border rounded-lg p-4">
                <summary class="font-bold text-brand-navy cursor-pointer">{f.q}</summary>
                <p class="text-sm text-brand-text mt-2 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mt-8 bg-white border border-brand-border rounded-xl p-5">
        <div class="font-bold text-brand-navy mb-3 text-sm">공식 출처</div>
        <ul class="space-y-1.5 text-sm">
          {entry.data.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener" class="text-brand-blue hover:underline">{s.name}</a></li>
          ))}
        </ul>
      </section>

      <div class="flex flex-wrap gap-2 mt-6">
        {entry.data.tags.map((t) => <span class="text-xs text-brand-muted bg-white border border-brand-border rounded-full px-2.5 py-1">#{t}</span>)}
      </div>
    </article>

    <aside class="space-y-6 md:sticky md:top-6 md:self-start">
      {toc.length > 0 && (
        <nav class="hidden md:block bg-white border border-brand-border rounded-xl p-5 text-sm">
          <div class="font-bold text-brand-navy mb-2">목차</div>
          <ul class="space-y-1">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'pl-4' : ''}>
                <a href={`#${h.slug}`} class="text-brand-muted hover:text-brand-blue">{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <AdSlot label="사이드바" />
      <div class="bg-white border border-brand-border rounded-xl p-5">
        <div class="font-bold text-brand-navy mb-3 text-sm">관련 글</div>
        <div class="space-y-3">
          {related.map((r) => (
            <a href={`/article/${r.id}`} class="block text-sm text-brand-text hover:text-brand-blue leading-snug">{r.data.title}</a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
