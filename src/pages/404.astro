---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);
---
<BaseLayout title="페이지를 찾을 수 없습니다 | 든든지원금" description="요청하신 페이지를 찾을 수 없습니다.">
  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <div class="text-5xl font-bold text-brand-navy mb-4">404</div>
    <p class="text-brand-muted mb-8">요청하신 페이지를 찾을 수 없습니다. 주소가 변경되었거나 삭제된 페이지일 수 있어요.</p>
    <a href="/" class="inline-block bg-brand-blue text-white font-bold rounded-lg px-6 py-3 hover:bg-brand-navy transition-colors mb-10">
      홈으로 돌아가기
    </a>

    {latest.length > 0 && (
      <div class="text-left bg-white border border-brand-border rounded-xl p-6">
        <div class="font-bold text-brand-navy mb-3 text-sm">최근 발행된 글</div>
        <ul class="space-y-2">
          {latest.map((a) => (
            <li><a href={`/article/${a.id}`} class="text-brand-blue hover:underline text-sm">{a.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>
