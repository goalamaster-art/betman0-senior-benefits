---
import { getCategory, formatDate, getThumbnailPath } from '../lib/categories';
interface Props {
  slug: string;
  title: string;
  summary: string;
  category: string;
  publishedAt: Date;
}
const { slug, title, summary, category, publishedAt } = Astro.props;
const cat = getCategory(category);
---
<a href={`/article/${slug}`} class="block bg-white border border-brand-border rounded-xl overflow-hidden hover:border-brand-blue hover:shadow-sm transition-all">
  <img src={getThumbnailPath(slug)} alt="" class="w-full h-36 object-cover" loading="lazy" />
  <div class="p-5">
  <span class="inline-block text-xs font-bold text-brand-blue bg-brand-blue-light rounded-full px-2.5 py-1 mb-3">{cat?.name}</span>
  <h3 class="font-bold text-brand-navy leading-snug mb-2">{title}</h3>
  <p class="text-sm text-brand-muted leading-relaxed line-clamp-2 mb-3">{summary}</p>
  <time class="text-xs text-brand-muted">{formatDate(publishedAt)}</time>
  </div>
</a>
